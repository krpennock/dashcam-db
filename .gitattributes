# Keep line endings predictable across the Windows PC and the Debian server.
# Shell scripts in particular must stay LF: the server will not run a .sh file
# that has CRLF endings.
*.sh    text eol=lf
*.py    text eol=lf
*.sql   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.conf  text eol=lf
*.toml  text eol=lf

*.ico   binary
*.jpg   binary
*.png   binary
*.mp4   binary
*.dump  binary
